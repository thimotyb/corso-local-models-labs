# OpenAI API key used when LLM_PROVIDER=openai.
OPENAI_API_KEY=

# Gemini Developer API key used when LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# Alternative Gemini API key name supported by Google libraries.
GOOGLE_API_KEY=

# DeepSeek API key used when LLM_PROVIDER=deepseek.
DEEPSEEK_API_KEY=

# Selects the active LLM provider: openai, ollama, gemini, or deepseek.
LLM_PROVIDER=ollama

# Base URL for the local or remote Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# Chat model used when LLM_PROVIDER=ollama.
OLLAMA_MODEL=gemma4:e2b

# Chat model used when LLM_PROVIDER=gemini.
GEMINI_MODEL=gemini-flash-latest

# Chat model used when LLM_PROVIDER=openai.
OPENAI_MODEL=gpt-5-nano

# Chat model used when LLM_PROVIDER=deepseek.
DEEPSEEK_MODEL=deepseek-v4-pro

# OpenAI-compatible DeepSeek endpoint.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Keep V4 non-thinking by default for predictable LangChain tool-call loops.
DEEPSEEK_THINKING=disabled

# DeepSeek does not provide embeddings. When LLM_PROVIDER=deepseek this
# defaults to gemini; set it to openai, ollama, or gemini to override it.
EMBEDDING_PROVIDER=

# Embedding model used for vector stores when EMBEDDING_PROVIDER=openai.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embedding model used for vector stores when EMBEDDING_PROVIDER=ollama. Pull it first with: ollama pull nomic-embed-text
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Embedding model used for vector stores when EMBEDDING_PROVIDER=gemini.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview

# LangSmith API key used to trace LangChain runs.
LANGSMITH_API_KEY=

# Enables LangSmith tracing when set to true. The ch07 notebook also enables it automatically when LANGSMITH_API_KEY is present.
LANGSMITH_TRACING=true

# LangSmith API endpoint.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# LangSmith project name where notebook traces are grouped.
LANGSMITH_PROJECT=Q & A chatbot





# --- tools/weather ---
# Free key from https://openweathermap.org/api (new keys can take a while to activate).
OPENWEATHER_API_KEY=
# Set to 1 to use a canned answer and need no key.
WEATHER_MOCK=
# Tool-calling script: OpenAI-compatible endpoint (Ollama by default, or a LiteLLM proxy) and model name.
LLM_BASE_URL=http://localhost:11434/v1
CHAT_MODEL=qwen3.5:9b
WEATHER_API_URL=http://127.0.0.1:8000
